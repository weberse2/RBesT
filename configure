#! /bin/sh

# Generated by rstantools.  Do not edit by hand.

"${R_HOME}/bin/Rscript" -e "rstantools::rstan_config()"

# When cross-compiling for WebAssembly (see tools/webr/build-rwasm.R and
# design/howto-build-rbest-webr.md), rwasm always invokes this script under
# emconfigure with --host=wasm32-unknown-emscripten -- regardless of any
# Makevars override it may also apply, since it backs up and replaces this
# very file before running it. rstan_config() above still writes a PKG_LIBS
# entry for RcppParallel::RcppParallelLibs(), which resolves to the host's
# native libtbb.so/libtbbmalloc.so -- wasm-ld cannot link those into a wasm
# binary. The wasm build of RcppParallel does not use TBB at all (it falls
# back to a header-only tinythread implementation), so drop that call from
# PKG_LIBS whenever configure runs for the wasm host triplet. This block must
# survive any future rstantools re-scaffolding of this file (e.g.
# `rstantools::use_rstan()`); re-add it if regenerated.
for arg; do
  case "$arg" in
    --host=wasm32-unknown-emscripten)
      sed -i.bak -e '/^PKG_LIBS/s#\$(shell "\$(R_HOME)/bin\$(R_ARCH_BIN)/Rscript" -e "RcppParallel::RcppParallelLibs()") ##' src/Makevars
      rm -f src/Makevars.bak
      ;;
  esac
done
