#! /bin/sh

# Generated by rstantools.  Do not edit by hand.

"${R_HOME}/bin/Rscript" -e "rstantools::rstan_config()"

# When cross-compiling for WebAssembly (see tools/webr/build-rwasm.R and
# design/howto-build-rbest-webr.md), rwasm always invokes this script under
# emconfigure with --host=wasm32-unknown-emscripten -- regardless of any
# Makevars override it may also apply, since it backs up and replaces this
# very file before running it. rstan_config() above writes a PKG_LIBS line built
# from two $(shell ...) calls, RcppParallel::RcppParallelLibs() and
# StanHeaders:::LdFlags(). Both are evaluated by the *host* R, and
# StanHeaders:::LdFlags() unconditionally expands to
#   -L<host RcppParallel>/lib -Wl,-rpath,<same> -ltbb -ltbbmalloc
# no matter whether TBB is usable on the target. wasm-ld then chokes on those
# native ELF objects ("unknown file type: .../libtbb.so"). webR is
# single-threaded and links side modules with
# --unresolved-symbols=import-dynamic, so RBesT needs no library of its own
# here: blank out PKG_LIBS entirely when configure runs for the wasm host
# triplet. This block must survive any future rstantools re-scaffolding of
# this file (e.g. `rstantools::use_rstan()`); re-add it if regenerated.
for arg; do
  case "$arg" in
    --host=wasm32-unknown-emscripten)
      sed -i.bak -e 's/^PKG_LIBS *=.*/PKG_LIBS =/' src/Makevars
      rm -f src/Makevars.bak
      ;;
  esac
done
